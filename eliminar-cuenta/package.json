{
  "name": "redjob",
  "version": "1.0.0",
  "private": true,
  "description": "RedJob mobile wrapper for Android and iOS.",
  "scripts": {
    "build": "node scripts/create-config.js",
    "mobile:prepare": "node scripts/prepare-mobile.js",
    "mobile:check": "node scripts/mobile-check.js",
    "mobile:sync": "npm run mobile:prepare && npx cap sync",
    "mobile:add:android": "npm run mobile:prepare && npx cap add android",
    "mobile:add:ios": "npm run mobile:prepare && npx cap add ios",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios",
    "twa:build:debug": "android-twa\\gradlew.bat -p android-twa :app:assembleDebug",
    "twa:build:aab": "android-twa\\gradlew.bat -p android-twa :app:bundleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/ios": "^7.4.3"
  }
}
